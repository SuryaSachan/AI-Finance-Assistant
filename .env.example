# ---------------------------------------------------------------------------
# Finance Assistant configuration
# Copy to `.env` and adjust. Every value has a safe default.
# ---------------------------------------------------------------------------

# LLM provider: "ollama" | "openai" | "none"
#   ollama -> local open-source model (recommended for the "smallest model" constraint)
#   openai -> any OpenAI-compatible endpoint (vLLM, Groq, Together, OpenRouter, Azure...)
#   none   -> deterministic rule-based mode, no LLM at all (always works offline)
LLM_PROVIDER=ollama

# Model used for BOTH planning (NL -> query plan) and narration.
# Must stay <= 20B parameters per the hackathon constraint.
LLM_MODEL=qwen2.5:3b-instruct

# Optional: a slightly larger model used ONLY when the small planner fails twice.
# Leave empty to disable the escalation tier.
LLM_MODEL_FALLBACK=

LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0

# Path to the DuckDB database file
DB_PATH=data/finance.duckdb

# Freeze "today" for reproducible demos (YYYY-MM-DD).
# Leave empty to use the latest date present in the dataset.
ANCHOR_DATE=

# Max rows returned to the UI / passed to the LLM
MAX_ROWS=200
LLM_ROW_BUDGET=25
